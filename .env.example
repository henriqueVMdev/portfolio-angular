# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx

# Destinatário (padrão: email do perfil em data/portfolio.ts)
CONTACT_TO_EMAIL=henrique.de.paula.valim@gmail.com

# Remetente verificado no Resend.
# Em desenvolvimento, use onboarding@resend.dev (só entrega no email da sua conta Resend).
# Em produção, use um domínio verificado: Portfolio <contato@seudominio.com>
CONTACT_FROM_EMAIL=Portfólio <onboarding@resend.dev>

# Hosts que o servidor SSR aceita no header Host / X-Forwarded-Host.
# localhost, 127.0.0.1 e *.vercel.app já vêm do angular.json, então os deploys
# da Vercel (produção e previews) funcionam sem configurar nada. Some aqui o
# domínio próprio quando existir — esta lista soma à do angular.json, não substitui.
# Host fora da lista recebe 400. Aceita curinga: *.seudominio.com
# Na Vercel, definir em Settings > Environment Variables.
NG_ALLOWED_HOSTS=seudominio.com,www.seudominio.com

# Cabeçalhos de proxy confiáveis. O padrão do Angular é só
# x-forwarded-host,x-forwarded-proto, e qualquer outro x-forwarded-* recebido
# derruba a resposta para client-side rendering. src/server.ts já assume os três
# de baixo, que é o que a Vercel manda; só defina isto para sobrescrever.
# NG_TRUST_PROXY_HEADERS=x-forwarded-for,x-forwarded-host,x-forwarded-proto,x-forwarded-port,x-forwarded-prefix,x-forwarded-ssl
